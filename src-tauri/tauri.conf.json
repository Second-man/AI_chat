{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EchoMate",
  "version": "0.1.0",
  "identifier": "com.secondman.echomate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && powershell -ExecutionPolicy Bypass -File backend\\build_sidecar.ps1"
  },
  "app": {
    "windows": [
      {
        "title": "EchoMate",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/echomate-api/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
